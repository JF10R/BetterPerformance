<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../GamePaths.local.props" Condition="Exists('../../GamePaths.local.props')" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <ValheimDir Condition="'$(ValheimDir)' == ''">$(VALHEIM_DIR)</ValheimDir>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="0Harmony"><HintPath>$(ValheimDir)/BepInEx/core/0Harmony.dll</HintPath></Reference>
    <Reference Include="BepInEx"><HintPath>$(ValheimDir)/BepInEx/core/BepInEx.dll</HintPath></Reference>
    <!-- Splatform.Steam.SteamCloud cannot be type-loaded on .NET Framework (default interface
         methods), so its IL is read from metadata. Resolved from the local BepInEx install. -->
    <Reference Include="Mono.Cecil"><HintPath>$(ValheimDir)/BepInEx/core/Mono.Cecil.dll</HintPath></Reference>
  </ItemGroup>
</Project>
